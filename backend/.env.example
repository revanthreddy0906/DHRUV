# Section 16 environment keys. Export these in your shell (the server does not load .env files).
PORT=4000
# Required when DEMO_MODE is not true.
JWT_SECRET=change-me
# Optional; the AI explainer falls back to templates without it.
ANTHROPIC_API_KEY=
DEMO_MODE=true
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DHRUV_DB_FILE=dhruv.db
